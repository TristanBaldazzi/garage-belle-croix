# Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env

# --- Serveur ---------------------------------------------------------------
# Port de l'API (le front pointe dessus via NEXT_PUBLIC_API_URL)
PORT=5001
# "production" en ligne : active le cookie de session sécurisé (HTTPS)
NODE_ENV=development
# Domaine du front autorisé à appeler l'API, en plus de localhost:3000 et garagebellecroix.fr
FRONTEND_URL=http://localhost:3000

# --- Base de données -------------------------------------------------------
# Par défaut : mongodb://localhost:27017/garage-belle-croix
MONGODB_URI=mongodb://localhost:27017/garage-belle-croix

# --- Authentification admin (obligatoire) ----------------------------------
# Chaîne longue et aléatoire, ex. : openssl rand -base64 48
JWT_SECRET=
# Durée de session de l'admin (défaut : 7d)
JWT_EXPIRE=7d

# --- Notifications e-mail (optionnel) --------------------------------------
# Sans SMTP, les demandes restent visibles dans l'admin uniquement.
# Adresse du garage qui reçoit un e-mail à chaque rendez-vous, devis ou message
NOTIFY_EMAIL=garagebellecroix@outlook.fr
# Serveur d'envoi, ex. Brevo : smtp-relay.brevo.com (587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (adresse validée chez le fournisseur SMTP) ; défaut : SMTP_USER
SMTP_FROM="Garage de la Belle Croix <noreply@garagebellecroix.fr>"
